# ------------------------------------------------------------------
# Required
# ------------------------------------------------------------------

# Signs session cookies, the form timing token, and salts the IP hash.
# Changing it signs everyone out and invalidates in-flight form tokens.
#   openssl rand -hex 32
APP_SECRET=

# The password you log in with — at least 10 characters.
# In Docker, and for local development, this is all you need: the container
# hashes it with argon2 at start-up and the server only ever sees the hash.
# Serving with `npm start` outside Docker skips that step, so there you need
# ADMIN_PASSWORD_HASH below.
ADMIN_PASSWORD=

# ------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------

# A pre-computed argon2 hash, if you would rather not keep the password in this
# file. Takes precedence over ADMIN_PASSWORD.
#   npm run hash-password
# ADMIN_PASSWORD_HASH=

# Public URL of this install. Used for the copy-paste snippets in the dashboard
# and for the redirect a plain HTML form POST follows. Falls back to the host the
# proxy forwards, which is fine unless your proxy does not send those headers.
# APP_URL=https://mail.example.com

# Where the SQLite file lives. Defaults to ./data/mailcatcher.db locally
# and /data/mailcatcher.db in Docker.
# DATABASE_PATH=./data/mailcatcher.db
